# LGED Rural Infrastructure GIS Management System — example environment.
# Copy to `.env` at the repo root and adjust as needed.
# Values that match these defaults can be omitted.

# ---------- Database ----------
# Used by the `db` service and inlined into DATABASE_URL for `backend`.
POSTGRES_PASSWORD=lged_dev_pw

# ---------- Backend ----------
# JWT signing secret. CHANGE THIS IN PRODUCTION (32+ random bytes).
JWT_SECRET_KEY=change_me_in_prod

# Optional overrides (defaults shown):
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=7
# ENVIRONMENT=development
# LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins for the frontend.
# Local dev:
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Production with domain (HTTPS after certbot):
# CORS_ORIGINS=https://quantumflux.cloud,http://quantumflux.cloud

# Set to "false" to skip the startup seed (e.g. in production).
# SEED_ON_STARTUP=true
